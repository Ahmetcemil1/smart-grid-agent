# Dynatrace API Configuration
DYNATRACE_ENV_URL=https://your-env-id.live.dynatrace.com
DYNATRACE_API_TOKEN=your_dynatrace_api_token_here

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Agent Configuration
AGENT_MODE=demo        # demo | live
CHECK_INTERVAL=30      # seconds between metric checks
CPU_IDLE_THRESHOLD=10  # CPU % below which services are considered idle
MEMORY_IDLE_THRESHOLD=15

# Flask API Server
API_HOST=0.0.0.0
API_PORT=5000
SECRET_KEY=smart-grid-secret-2024
